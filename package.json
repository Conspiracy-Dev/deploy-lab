{
  "name": "deploy-lab",
  "description": "SEO- and Core Web Vitals-focused Nuxt foundation for the DeployLab company site.",
  "type": "module",
  "private": true,
  "author": "Igor Shavlovsky",
  "license": "Apache-2.0",
  "scripts": {
    "build": "nuxt build",
    "commitlint": "commitlint",
    "contour:doctor": "node scripts/contour/contour-doctor.mjs",
    "contour:doctor:clone": "pnpm contour:doctor -- --clone-check",
    "dead-code": "knip",
    "dev": "nuxt dev",
    "deps:check": "depcruise --config .dependency-cruiser.cjs app shared test",
    "deps:cycles": "madge --circular --warning --extensions ts,vue --ts-config tsconfig.json app shared test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "guard-local-files": "node scripts/contour/guard-local-files.mjs",
    "hooks:version": "lefthook version",
    "lint": "eslint .",
    "lighthouse": "lhci autorun",
    "lint:styles": "stylelint \"app/**/*.{css,vue}\" --max-warnings 0",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "lefthook install",
    "quality:static": "pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm slop-scan && pnpm test:unit",
    "secrets:check": "node scripts/tooling/run-gitleaks.mjs dir --config .gitleaks.toml --redact=100 --no-banner .",
    "setup": "node scripts/onboarding/setup.mjs",
    "setup:doctor": "node scripts/onboarding/doctor.mjs",
    "slop-scan": "node scripts/contour/slop-scan.mjs",
    "task:intake:check": "node scripts/onboarding/task-intake-check.mjs",
    "test:onboarding": "node scripts/onboarding/task-intake-check.test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.4.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.7",
    "@tresjs/nuxt": "^5.6.3",
    "@unocss/nuxt": "^66.7.5",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.1",
    "nuxt-security": "^2.6.0",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "madge": "^8.0.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.9.3",
    "unocss": "66.7.5",
    "vitest": "^4.1.10",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "^3.3.9"
  }
}
