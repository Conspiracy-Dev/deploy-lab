# Canonical public origin. Required before deploying the production site.
NUXT_PUBLIC_SITE_URL=https://deploylab.example

# Private server-only Notion integration configuration. Supply values through
# the deployment secret store; never expose them with the NUXT_PUBLIC_ prefix.
NUXT_NOTION_TOKEN=
NUXT_NOTION_DATA_SOURCE_ID=

# Set only when Nginx/Caddy overwrites X-Forwarded-For before reaching Nitro.
NUXT_TRUST_PROXY=false
