#!/usr/bin/env bash

set -euo pipefail

readonly compose_file="${DEPLOY_LAB_COMPOSE_FILE:-/opt/deploy-lab/compose.yaml}"
readonly state_dir="${DEPLOY_LAB_STATE_DIR:-/var/lib/deploy-lab}"
readonly current_env_file="$state_dir/current-image.env"
readonly previous_env_file="$state_dir/previous-image.env"
readonly domain="${DEPLOY_LAB_DOMAIN:-noash.net}"
readonly image_pattern='^ghcr\.io/conspiracy-dev/deploy-lab@sha256:[0-9a-f]{64}$'

usage() {
  echo "Usage: deploy-lab ghcr.io/conspiracy-dev/deploy-lab@sha256:<64-lowercase-hex>" >&2
}

if [[ $# -ne 1 || ! $1 =~ $image_pattern ]]; then
  usage
  exit 64
fi

readonly image_ref="$1"

if [[ ! -f $compose_file ]]; then
  echo "Missing runtime configuration: $compose_file" >&2
  exit 78
fi

install -d -m 0750 "$state_dir"
candidate_env_file="$(mktemp "$state_dir/candidate-image.XXXXXX")"
cleanup() {
  rm -f "$candidate_env_file"
}
trap cleanup EXIT

printf 'IMAGE_REF=%s\nDOMAIN=%s\n' "$image_ref" "$domain" > "$candidate_env_file"

compose() {
  docker compose --env-file "$1" -f "$compose_file" "${@:2}"
}

verify_running_site() {
  local attempt

  for attempt in {1..18}; do
    if curl --fail --silent --show-error --resolve "$domain:443:127.0.0.1" "https://$domain/" >/dev/null \
      && [[ $(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
        --resolve "$domain:443:127.0.0.1" "https://$domain/api/contact") == '405' ]]; then
      return 0
    fi
    sleep 5
  done

  return 1
}

verify_public_site() {
  local path

  for path in / /privacy-policy /robots.txt /sitemap.xml; do
    curl --fail --silent --show-error "https://$domain$path" >/dev/null
  done

  [[ $(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    "https://$domain/api/contact") == '405' ]]
}

verify_runtime_image() {
  [[ $(docker image inspect "$1" --format '{{ index .Config.Labels "dev.deploy-lab.runtime" }}') == 'contact-v1' ]]
}

restore_previous_release() {
  if [[ ! -f $previous_env_file ]]; then
    echo 'No previous image is available; stopping the failed first rollout.' >&2
    compose "$current_env_file" down --remove-orphans || true
    rm -f "$current_env_file"
    return 1
  fi

  local previous_image
  previous_image="$(sed -n 's/^IMAGE_REF=//p' "$previous_env_file")"
  if ! verify_runtime_image "$previous_image"; then
    echo 'The previous image is not compatible with the contact runtime.' >&2
    return 1
  fi

  echo 'Restoring the previous image digest.' >&2
  install -m 0640 "$previous_env_file" "$current_env_file"
  compose "$current_env_file" pull site \
    && compose "$current_env_file" up --detach --remove-orphans --wait --wait-timeout 120 \
    && verify_running_site \
    && verify_public_site
}

if [[ -f $current_env_file ]]; then
  current_image="$(sed -n 's/^IMAGE_REF=//p' "$current_env_file")"
  if ! verify_runtime_image "$current_image"; then
    echo 'The first contact-runtime migration requires owner maintenance; the current static release was not changed.' >&2
    exit 78
  fi
fi

if ! compose "$candidate_env_file" config --quiet; then
  echo 'Compose configuration validation failed.' >&2
  exit 78
fi

if ! compose "$candidate_env_file" pull site \
  || ! verify_runtime_image "$image_ref" \
  || ! docker run --rm --network none -e "DOMAIN=$domain" \
    -v /opt/deploy-lab/Caddyfile:/etc/caddy/Caddyfile:ro \
    "$image_ref" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile; then
  echo 'The candidate image could not be pulled or its Caddy configuration is invalid.' >&2
  exit 70
fi

if [[ -f $current_env_file ]]; then
  install -m 0640 "$current_env_file" "$previous_env_file"
fi

install -m 0640 "$candidate_env_file" "$current_env_file"

if compose "$current_env_file" up --detach --remove-orphans --wait --wait-timeout 120 \
  && verify_running_site \
  && verify_public_site; then
  echo "Release is healthy: $image_ref"
  exit 0
fi

echo 'Candidate rollout failed.' >&2
if restore_previous_release; then
  echo 'Previous release restored after candidate failure.' >&2
  exit 75
fi

echo 'Previous release could not be restored.' >&2
exit 70
